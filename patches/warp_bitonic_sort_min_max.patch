From 3c21e9e6e148e9db956df7eaa63dddeaa308a12f Mon Sep 17 00:00:00 2001
From: lennartvoelz <lvoelz@outlook.de>
Date: Wed, 21 Oct 2026 20:59:58 +0200
Subject: [PATCH 1/2] Enable Min/Max based compare operator to bitonic sort

- add type trait is_min_max_op that checks if a CompareOp has min and max operators and if the result is the same type as KeyT
- dispatch based on the type trait and chose the min/max path when the user supplies a min/max operator
- only allow the min/max operator when the user request key-only sort
---
 cub/cub/warp/warp_bitonic_sort.cuh | 62 +++++++++++++++++++++++++-----
 1 file changed, 53 insertions(+), 9 deletions(-)

diff --git a/cub/cub/warp/warp_bitonic_sort.cuh b/cub/cub/warp/warp_bitonic_sort.cuh
index 570bed53c6..250518594f 100644
--- a/cub/cub/warp/warp_bitonic_sort.cuh
+++ b/cub/cub/warp/warp_bitonic_sort.cuh
@@ -27,13 +27,35 @@
 #include <cuda/std/__bit/popcount.h>
 #include <cuda/std/__type_traits/is_default_constructible.h>
 #include <cuda/std/__type_traits/is_same.h>
+#include <cuda/std/__type_traits/remove_cvref.h>
 #include <cuda/std/__type_traits/void_t.h>
+#include <cuda/std/__utility/declval.h>
 #include <cuda/std/__utility/swap.h>
 
 CUB_NAMESPACE_BEGIN
 
 namespace detail
 {
+// Type trait to detect if the passed functor has min and max members
+template <typename CompareOp, typename KeyT, typename = void>
+inline constexpr bool is_min_max_op_v = false;
+
+// TODO: simplify and make more readable
+template <typename CompareOp, typename KeyT>
+inline constexpr bool is_min_max_op_v<
+  CompareOp,
+  KeyT,
+  ::cuda::std::void_t<decltype(::cuda::std::declval<CompareOp&>().min(
+                        ::cuda::std::declval<const KeyT&>(), ::cuda::std::declval<const KeyT&>())),
+                      decltype(::cuda::std::declval<CompareOp&>().max(
+                        ::cuda::std::declval<const KeyT&>(), ::cuda::std::declval<const KeyT&>()))>> =
+  ::cuda::std::is_same_v<::cuda::std::remove_cvref_t<decltype(::cuda::std::declval<CompareOp&>().min(
+                           ::cuda::std::declval<const KeyT&>(), ::cuda::std::declval<const KeyT&>()))>,
+                         KeyT>
+  && ::cuda::std::is_same_v<::cuda::std::remove_cvref_t<decltype(::cuda::std::declval<CompareOp&>().max(
+                              ::cuda::std::declval<const KeyT&>(), ::cuda::std::declval<const KeyT&>()))>,
+                            KeyT>;
+
 //! @rst
 //! The WarpBitonicSort class provides methods for sorting items partitioned across a CUDA warp
 //! using a bitonic sorting network.
@@ -343,18 +365,40 @@ private:
     _CCCL_PRAGMA_UNROLL_FULL()
     for (int i = 0; i < second_half_len; ++i)
     {
-      const int other_i      = i + first_half_len;
-      KeyT& key              = keys[i];
-      KeyT& other_key        = keys[other_i];
-      const bool should_swap = (Reverse) ? compare_op(key, other_key) : compare_op(other_key, key);
+      const int other_i = i + first_half_len;
+      KeyT& key         = keys[i];
+      KeyT& other_key   = keys[other_i];
 
-      if (should_swap)
+      if constexpr (is_min_max_op_v<CompareOp, KeyT>)
       {
-        using ::cuda::std::swap;
-        swap(key, other_key);
-        if constexpr (!keys_only)
+        static_assert(keys_only, "Min/Max operators support keys-sort only");
+
+        const KeyT max_key = compare_op.max(key, other_key);
+        const KeyT min_key = compare_op.min(key, other_key);
+
+        if constexpr (Reverse)
         {
-          swap(values[i], values[other_i]);
+          key       = max_key;
+          other_key = min_key;
+        }
+        else
+        {
+          key       = min_key;
+          other_key = max_key;
+        }
+      }
+      else
+      {
+        const bool should_swap = (Reverse) ? compare_op(key, other_key) : compare_op(other_key, key);
+
+        if (should_swap)
+        {
+          using ::cuda::std::swap;
+          swap(key, other_key);
+          if constexpr (!keys_only)
+          {
+            swap(values[i], values[other_i]);
+          }
         }
       }
     }
-- 
2.43.0


From 688bb933112657c344a79c6c9b93e171ba2cefc8 Mon Sep 17 00:00:00 2001
From: lennartvoelz <lvoelz@outlook.de>
Date: Thu, 22 Oct 2026 11:03:26 +0200
Subject: [PATCH 2/2] Add comment to the bitonic sort implementation, stating
 the contract

---
 cub/cub/warp/warp_bitonic_sort.cuh | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/cub/cub/warp/warp_bitonic_sort.cuh b/cub/cub/warp/warp_bitonic_sort.cuh
index 250518594f..b4e0e436f4 100644
--- a/cub/cub/warp/warp_bitonic_sort.cuh
+++ b/cub/cub/warp/warp_bitonic_sort.cuh
@@ -36,7 +36,10 @@ CUB_NAMESPACE_BEGIN
 
 namespace detail
 {
-// Type trait to detect if the passed functor has min and max members
+// Type trait to detect if the passed functor has min and max members that return KeyT. Such an operator replaces the
+// comparator in keys-only sorts and must keep the keys a permutation: for every pair of keys a and b,
+// {min(a, b), max(a, b)} must equal {a, b}, with min(a, b) ordered before or equivalent to max(a, b) under one strict
+// weak order for all pairs
 template <typename CompareOp, typename KeyT, typename = void>
 inline constexpr bool is_min_max_op_v = false;
 
@@ -156,6 +159,9 @@ public:
   //! - Sort is not guaranteed to be stable. That is, suppose that `i` and `j` are equivalent: neither one is less than
   //!   the other. It is not guaranteed that the relative order of these two elements will be preserved by sort.
   //! - All threads in the calling logical warp must invoke this collective.
+  //! - `compare_op` can also be a min/max operator with `min(a, b)` and `max(a, b)` members that return `KeyT`. For
+  //!   every pair of keys, `{min(a, b), max(a, b)}` must be a permutation of `{a, b}`, ordered consistently for all
+  //!   pairs. `cuda::std::fmin` and `cuda::std::fmax` meet this only for keys without NaN.
   //!
   //! @tparam CompareOp Comparison functor type
   //!
-- 
2.43.0

